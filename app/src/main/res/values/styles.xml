<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zippio" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="android:colorControlActivated">@color/color_primary</item>
        <item name="android:colorControlNormal">@color/color_on_surface_variant</item>
        <item name="android:colorControlHighlight">@color/color_pressed_on_light</item>
        <item name="android:textColorPrimary">@color/color_on_surface</item>
        <item name="android:textColorSecondary">@color/color_on_surface_variant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="TextAppearance.Zippio.Display" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/color_on_hero</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Zippio.Headline" parent="android:style/TextAppearance.Material.Title">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Zippio.Title" parent="android:style/TextAppearance.Material.Title">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Zippio.Body" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Zippio.Label" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Zippio.Overline" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.Zippio.Card" parent="">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:elevation">1dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Zippio.Button.Primary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:drawableTint">@color/button_primary_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Zippio.Button.Secondary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:drawableTint">@color/button_secondary_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Zippio.Button.Accent" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_accent</item>
        <item name="android:drawableTint">@color/button_accent_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_accent_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Zippio.Button.AccentSecondary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_accent_secondary</item>
        <item name="android:drawableTint">@color/button_accent_secondary_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_accent_secondary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Zippio.CheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/control_tint</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
