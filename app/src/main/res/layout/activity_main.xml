<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textColor="@color/zippio_ink"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle"
                android:textColor="@color/zippio_muted"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/badge_background"
                android:text="@string/local_processing_badge"
                android:textColor="@color/zippio_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/info_background"
            android:text="@string/supported_formats"
            android:textColor="@color/zippio_ink"
            android:lineSpacingExtra="2dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compress_section_title"
                android:textColor="@color/zippio_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/compress_section_description"
                android:textColor="@color/zippio_muted"
                android:lineSpacingExtra="2dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/archive_format_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/format_spinner"
                android:text="@string/archive_format"
                android:textColor="@color/zippio_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/format_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/zippio_primary"
                android:paddingEnd="4dp"
                android:paddingStart="4dp" />

            <TextView
                android:id="@+id/compression_level_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@id/compression_level_spinner"
                android:text="@string/compression_level"
                android:textColor="@color/zippio_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/compression_level_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/zippio_primary"
                android:paddingEnd="4dp"
                android:paddingStart="4dp" />

            <CheckBox
                android:id="@+id/include_root_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/control_tint"
                android:minHeight="48dp"
                android:text="@string/include_root_folder"
                android:textColor="@color/zippio_ink"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/include_hidden_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/control_tint"
                android:minHeight="48dp"
                android:text="@string/include_hidden_files"
                android:textColor="@color/zippio_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@id/password_input"
                android:text="@string/password_label"
                android:textColor="@color/zippio_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/password_input"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:backgroundTint="@color/zippio_primary"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/zippio_ink"
                    android:textColorHint="@color/zippio_muted"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/show_password"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:buttonTint="@color/control_tint"
                    android:gravity="center_vertical"
                    android:text="@string/show_password"
                    android:textColor="@color/zippio_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/password_strength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/password_note"
                android:textColor="@color/zippio_muted"
                android:lineSpacingExtra="2dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/compress_folder_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/button_primary_background"
                android:text="@string/compress_folder"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/compress_files_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/button_secondary_background"
                android:text="@string/compress_files"
                android:textAllCaps="false"
                android:textColor="@color/button_secondary_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/extract_section_title"
                android:textColor="@color/zippio_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/extract_section_description"
                android:textColor="@color/zippio_muted"
                android:lineSpacingExtra="2dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/extract_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/button_accent_background"
                android:text="@string/extract"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/verify_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/button_accent_secondary_background"
                android:text="@string/verify_archive"
                android:textAllCaps="false"
                android:textColor="@color/button_accent_secondary_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/info_background"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/zippio_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progressTint="@color/zippio_primary"
                android:max="100" />

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/button_secondary_background"
                android:text="@string/cancel_operation"
                android:textAllCaps="false"
                android:textColor="@color/button_secondary_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/status_background"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:minHeight="56dp"
            android:text="@string/idle"
            android:textColor="@color/zippio_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:text="@string/workflow_note"
            android:textColor="@color/zippio_muted"
            android:lineSpacingExtra="3dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reset_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/button_secondary_background"
            android:text="@string/reset_settings"
            android:textAllCaps="false"
            android:textColor="@color/button_secondary_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/privacy_note"
            android:textColor="@color/zippio_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
