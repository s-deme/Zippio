<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/screen_vertical_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_background"
            android:orientation="vertical"
            android:padding="@dimen/hero_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/hero_icon_background"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_zippio" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title"
                        android:textAppearance="@style/TextAppearance.Zippio.Display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:alpha="0.88"
                        android:text="@string/subtitle"
                        android:textColor="@color/color_on_hero"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/badge_background"
                android:drawableStart="@drawable/ic_privacy"
                android:drawablePadding="8dp"
                android:drawableTint="@color/color_on_hero"
                android:text="@string/local_processing_badge"
                android:textColor="@color/color_on_hero"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:alpha="0.86"
                android:lineSpacingExtra="2dp"
                android:text="@string/supported_formats"
                android:textColor="@color/color_on_hero"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/status_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_activity" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_label"
                    android:textColor="@color/color_on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/idle"
                    android:textColor="@color/color_on_primary_container"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/info_background"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_label"
                android:textAppearance="@style/TextAppearance.Zippio.Overline" />

            <TextView
                android:id="@+id/progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/color_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_sm"
                android:max="100"
                android:progressBackgroundTint="@color/color_surface_container_high"
                android:progressTint="@color/color_primary" />

            <Button
                android:id="@+id/cancel_button"
                style="@style/Widget.Zippio.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minWidth="144dp"
                android:text="@string/cancel_operation" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Zippio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_overline"
                android:textAppearance="@style/TextAppearance.Zippio.Overline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/compress_section_title"
                android:textAppearance="@style/TextAppearance.Zippio.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/compress_section_description"
                android:textAppearance="@style/TextAppearance.Zippio.Body" />

            <TextView
                android:id="@+id/archive_format_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/format_spinner"
                android:text="@string/archive_format"
                android:textAppearance="@style/TextAppearance.Zippio.Label" />

            <FrameLayout
                android:id="@+id/format_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:addStatesFromChildren="true"
                android:background="@drawable/field_background"
                android:minHeight="@dimen/control_height">

                <Spinner
                    android:id="@+id/format_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:minHeight="@dimen/control_height"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </FrameLayout>

            <TextView
                android:id="@+id/compression_level_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/compression_level_spinner"
                android:text="@string/compression_level"
                android:textAppearance="@style/TextAppearance.Zippio.Label" />

            <FrameLayout
                android:id="@+id/compression_level_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:addStatesFromChildren="true"
                android:background="@drawable/field_background"
                android:minHeight="@dimen/control_height">

                <Spinner
                    android:id="@+id/compression_level_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:minHeight="@dimen/control_height"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/info_background"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs">

                <CheckBox
                    android:id="@+id/include_root_folder"
                    style="@style/Widget.Zippio.CheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/include_root_folder" />

                <CheckBox
                    android:id="@+id/include_hidden_files"
                    style="@style/Widget.Zippio.CheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/include_hidden_files" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/password_section_title"
                android:textAppearance="@style/TextAppearance.Zippio.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/password_section_description"
                android:textAppearance="@style/TextAppearance.Zippio.Body" />

            <TextView
                android:id="@+id/password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/password_input"
                android:text="@string/password_label"
                android:textAppearance="@style/TextAppearance.Zippio.Label" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:autofillHints="password"
                android:background="@drawable/field_background"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:maxLines="1"
                android:minHeight="@dimen/control_height"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_on_surface_variant"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/show_password"
                style="@style/Widget.Zippio.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_password" />

            <TextView
                android:id="@+id/password_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:accessibilityLiveRegion="polite"
                android:text="@string/password_note"
                android:textAppearance="@style/TextAppearance.Zippio.Body"
                android:textSize="13sp" />

            <Button
                android:id="@+id/compress_folder_button"
                style="@style/Widget.Zippio.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:drawableStart="@drawable/ic_folder"
                android:text="@string/compress_folder" />

            <Button
                android:id="@+id/compress_files_button"
                style="@style/Widget.Zippio.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawableStart="@drawable/ic_files"
                android:text="@string/compress_files" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Zippio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_overline"
                android:textAppearance="@style/TextAppearance.Zippio.Overline"
                android:textColor="@color/color_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/extract_section_title"
                android:textAppearance="@style/TextAppearance.Zippio.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/extract_section_description"
                android:textAppearance="@style/TextAppearance.Zippio.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/accent_panel_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_sm">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_privacy" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/extract_safety_note"
                    android:textColor="@color/color_on_secondary_container"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/extract_button"
                style="@style/Widget.Zippio.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:drawableStart="@drawable/ic_extract"
                android:text="@string/extract" />

            <Button
                android:id="@+id/verify_button"
                style="@style/Widget.Zippio.Button.AccentSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawableStart="@drawable/ic_verify"
                android:text="@string/verify_archive" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/info_background"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/workflow_note"
                android:textAppearance="@style/TextAppearance.Zippio.Body"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/reset_button"
            style="@style/Widget.Zippio.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:minWidth="196dp"
            android:text="@string/reset_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:drawableStart="@drawable/ic_privacy"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="@string/privacy_note"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
