<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/screen_vertical_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/space_2xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Zippio.Headline"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.Zippio.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/supported_formats"
            android:textAppearance="@style/TextAppearance.Zippio.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/info_background"
            android:orientation="horizontal"
            android:padding="@dimen/space_2xs">

            <Button
                android:id="@+id/extract_mode_button"
                style="@style/Widget.Zippio.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/mode_extract" />

            <Button
                android:id="@+id/compress_mode_button"
                style="@style/Widget.Zippio.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2xs"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/mode_compress" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Zippio.Body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/status_background"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/error_title"
                android:textColor="@color/color_error"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:accessibilityLiveRegion="assertive"
                android:textAppearance="@style/TextAppearance.Zippio.Body" />

            <Button
                android:id="@+id/error_recovery_button"
                style="@style/Widget.Zippio.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/retry" />

            <Button
                android:id="@+id/error_dismiss_button"
                style="@style/Widget.Zippio.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/dismiss" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/info_background"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_label"
                android:textAppearance="@style/TextAppearance.Zippio.Overline" />

            <TextView
                android:id="@+id/progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:accessibilityLiveRegion="assertive"
                android:textColor="@color/color_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_sm"
                android:max="100"
                android:progressBackgroundTint="@color/color_surface_container_high"
                android:progressTint="@color/color_primary" />

            <Button
                android:id="@+id/cancel_button"
                style="@style/Widget.Zippio.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minWidth="144dp"
                android:text="@string/cancel_operation" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/extract_content"
            style="@style/Widget.Zippio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:id="@+id/extract_workflow_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extract_section_title"
                    android:textAppearance="@style/TextAppearance.Zippio.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/extract_section_description"
                    android:textAppearance="@style/TextAppearance.Zippio.Body" />

                <Button
                    android:id="@+id/extract_button"
                    style="@style/Widget.Zippio.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:drawableStart="@drawable/ic_extract"
                    android:text="@string/extract_select_file" />

                <Button
                    android:id="@+id/extract_password_toggle"
                    style="@style/Widget.Zippio.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/extract_password_toggle" />

                <LinearLayout
                    android:id="@+id/extract_password_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/extract_password_title"
                        android:textAppearance="@style/TextAppearance.Zippio.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/extract_password_description"
                        android:textAppearance="@style/TextAppearance.Zippio.Body"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <EditText
                            android:id="@+id/extract_password_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:background="@drawable/field_background"
                            android:importantForAutofill="yes"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:minHeight="@dimen/control_height"
                            android:paddingStart="16dp"
                            android:paddingEnd="56dp"
                            android:textColor="@color/color_on_surface"
                            android:textSize="16sp" />

                        <ImageButton
                            android:id="@+id/extract_show_password_button"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center_vertical|end"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/show_password"
                            android:padding="12dp"
                            android:src="@drawable/ic_visibility"
                            android:tint="@color/color_on_surface_variant" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:drawableStart="@drawable/ic_privacy"
                    android:drawablePadding="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:text="@string/extract_safety_note"
                    android:textAppearance="@style/TextAppearance.Zippio.Body"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/extract_result_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/extract_result_title"
                    android:textAppearance="@style/TextAppearance.Zippio.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/extract_result_message"
                    android:textAppearance="@style/TextAppearance.Zippio.Body" />

                <Button
                    android:id="@+id/extract_again_button"
                    style="@style/Widget.Zippio.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/extract_again" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compress_content"
            style="@style/Widget.Zippio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/compress_workflow_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compress_section_title"
                    android:textAppearance="@style/TextAppearance.Zippio.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/compress_section_description"
                    android:textAppearance="@style/TextAppearance.Zippio.Body" />

                <LinearLayout
                    android:id="@+id/compress_source_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/compress_files_button"
                        style="@style/Widget.Zippio.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_files"
                        android:text="@string/select_files" />

                    <Button
                        android:id="@+id/compress_folder_button"
                        style="@style/Widget.Zippio.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:drawableStart="@drawable/ic_folder"
                        android:text="@string/select_folder" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/compress_source_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/info_background"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/selected_source_label"
                        android:textAppearance="@style/TextAppearance.Zippio.Overline" />

                    <TextView
                        android:id="@+id/compress_source_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/color_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/compress_change_button"
                            style="@style/Widget.Zippio.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="@string/change_selection" />

                        <Button
                            android:id="@+id/compress_clear_button"
                            style="@style/Widget.Zippio.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="@string/clear_selection" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/compress_settings_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/archive_format"
                        android:textAppearance="@style/TextAppearance.Zippio.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="@drawable/info_background"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_2xs">

                        <Button
                            android:id="@+id/zip_format_button"
                            style="@style/Widget.Zippio.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="@string/format_zip" />

                        <Button
                            android:id="@+id/seven_z_format_button"
                            style="@style/Widget.Zippio.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2xs"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="@string/format_7z" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/format_help_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/format_zip_help"
                        android:textAppearance="@style/TextAppearance.Zippio.Body"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/format_field"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:visibility="gone">

                        <Spinner
                            android:id="@+id/format_spinner"
                            android:layout_width="1dp"
                            android:layout_height="1dp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/password_section_title"
                        android:textAppearance="@style/TextAppearance.Zippio.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:text="@string/password_section_description"
                        android:textAppearance="@style/TextAppearance.Zippio.Body"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <EditText
                            android:id="@+id/password_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:background="@drawable/field_background"
                            android:importantForAutofill="yes"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:minHeight="@dimen/control_height"
                            android:paddingStart="16dp"
                            android:paddingEnd="56dp"
                            android:textColor="@color/color_on_surface"
                            android:textSize="16sp" />

                        <ImageButton
                            android:id="@+id/show_password_button"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center_vertical|end"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/show_password"
                            android:padding="12dp"
                            android:src="@drawable/ic_visibility"
                            android:tint="@color/color_on_surface_variant" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/password_strength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xs"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/password_note"
                        android:textAppearance="@style/TextAppearance.Zippio.Body"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/advanced_toggle_button"
                        style="@style/Widget.Zippio.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/advanced_settings" />

                    <LinearLayout
                        android:id="@+id/advanced_settings_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/compression_level_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:labelFor="@id/compression_level_spinner"
                            android:text="@string/compression_level"
                            android:textAppearance="@style/TextAppearance.Zippio.Label" />

                        <FrameLayout
                            android:id="@+id/compression_level_field"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:addStatesFromChildren="true"
                            android:background="@drawable/field_background"
                            android:minHeight="@dimen/control_height">

                            <Spinner
                                android:id="@+id/compression_level_spinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:minHeight="@dimen/control_height"
                                android:spinnerMode="dropdown" />
                        </FrameLayout>

                        <CheckBox
                            android:id="@+id/include_root_folder"
                            style="@style/Widget.Zippio.CheckBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/include_root_folder" />

                        <CheckBox
                            android:id="@+id/include_hidden_files"
                            style="@style/Widget.Zippio.CheckBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/include_hidden_files" />

                        <Button
                            android:id="@+id/reset_button"
                            style="@style/Widget.Zippio.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/reset_settings" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/compress_execute_button"
                        style="@style/Widget.Zippio.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/compress_execute" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/compress_result_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compress_result_title"
                    android:textAppearance="@style/TextAppearance.Zippio.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/compress_result_message"
                    android:textAppearance="@style/TextAppearance.Zippio.Body" />

                <Button
                    android:id="@+id/share_button"
                    style="@style/Widget.Zippio.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/share" />

                <Button
                    android:id="@+id/compress_again_button"
                    style="@style/Widget.Zippio.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/compress_again" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/info_background"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notification_prompt_title"
                android:textColor="@color/color_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/notification_prompt_message"
                android:textAppearance="@style/TextAppearance.Zippio.Body" />

            <Button
                android:id="@+id/enable_notifications_button"
                style="@style/Widget.Zippio.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/enable_notifications" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:drawableStart="@drawable/ic_privacy"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="@string/privacy_note"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
